<?xml version="1.0" encoding="utf-8"?>
<!-- 白い熊 GNU Gauguin: the theme of the fork's own UI page. It names no colour of a themed surface:
     ThemeOverlay.Shiroikuma (sk_theme.xml) is laid over it in code and points every colour attribute
     at a role. The one value here is what the platform draws before any code runs. -->
<resources>
    <style name="Theme.Gauguin.ShiroikumaUi" parent="Theme.Material3.Dark.NoActionBar">
        <!-- the window of a starting activity, drawn by the platform before the roles can be read;
             repainted from the background role in GauguinUiActivity.onCreate -->
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
