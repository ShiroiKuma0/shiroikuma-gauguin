<?xml version="1.0" encoding="utf-8"?>
<!-- The 白い熊 GNU Gauguin UI page: the title, and the settings list scrolling under it.
     No colour here: the page is painted from the roles in GauguinUiActivity. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/gauguinUiRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <TextView
        android:id="@+id/gauguinUiTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="2dp"
        android:text="@string/gauguin_ui_title"
        android:textSize="22sp"
        android:textStyle="bold" />

    <View
        android:id="@+id/gauguinUiRuleTop"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginTop="6dp" />

    <FrameLayout
        android:id="@+id/gauguinUiContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
