<?xml version="1.0" encoding="utf-8"?>
<!-- 白い熊 GNU Gauguin settings category header: a full-width hairline marking the break from the
     previous group, then a big bold yellow heading with a WORD-WIDTH yellow underline. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="10dp"
    android:paddingBottom="2dp">

    <View
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:background="@color/shiroikuma_yellow" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="36dp"
        android:paddingTop="8dp">

        <TextView
            android:id="@android:id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/shiroikuma_yellow"
            android:textSize="20sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="2.5dp"
            android:layout_marginTop="2dp"
            android:background="@color/shiroikuma_yellow" />
    </LinearLayout>
</LinearLayout>
