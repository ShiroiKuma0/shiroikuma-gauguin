<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:installLocation="auto"
    android:versionCode="77"
    android:versionName="0.52.1">

    <!-- 白い熊 fork: the Export/Import page writes its backup ZIP to a folder 白い熊 chooses, and the
         保存復元 automation contract may be handed an absolute path to write to. Both need
         all-files access; the code checks the grant with Environment.isExternalStorageManager()
         rather than discovering it by failing. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 白い熊 fork: package visibility. Every reply this app sends is setPackage()'d at one of
         these two, and without naming them here that resolution fails **silently** on Android 11+ —
         the export runs, writes correctly and is never heard of. 応用管理 drives the data door of
         §2a; 自由作業盤 drives the 保存復元 broadcast batch of §1. -->
    <queries>
        <package android:name="shiroikuma.oyokanri" />
        <package android:name="shiroikuma.jiyusagyoban" />
    </queries>

    <application
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/AppTheme"
        android:name=".MainApplication"
        android:supportsRtl="true"
        android:allowBackup="true"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.newgame.NewGameActivity" />
        <activity android:name=".ui.challenge.ChooseChallengeActivity" />
        <activity android:name=".ui.LoadGameListActivity" />
        <activity android:name=".ui.statistics.StatisticsActivity" />
        <activity android:name=".ui.statistics.legacy.LegacyStatisticsActivity" />
        <activity android:name=".ui.statistics.legacy.LegacyStatisticsMaximizeOneDiagramActivity" />
        <activity android:name=".ui.AboutActivity" />
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false" />

        <!-- 白い熊 fork: the house UI page (colours, fonts, sizes, borders, export/import). -->
        <activity
            android:name=".ui.customui.GauguinUiActivity"
            android:exported="false"
            android:label="@string/gauguin_ui_title" />

        <!-- 白い熊 fork: the 保存復元 automation contract, §1. No android:permission — the caller
             cannot hold one. In contract v2 this is the deliberately UNAUTHENTICATED half of the
             surface: it only ever writes where it was told to and reports what it did. Anything
             that moves data through a caller-supplied descriptor lives behind the provider below,
             which knows who is calling — and `import` exists only there, never as a broadcast.
             The cancel action must live on this EXPORTED receiver, because the service it signals
             is (correctly) not exported. -->
        <receiver
            android:name=".ui.customui.StateExportReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="shiroikuma.gauguin.action.EXPORT_STATE" />
                <action android:name="shiroikuma.gauguin.action.LIST_CATEGORIES" />
                <action android:name="shiroikuma.gauguin.action.CANCEL_EXPORT" />
            </intent-filter>
        </receiver>

        <service
            android:name=".ui.customui.StateExportService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 白い熊 fork: the 保存復元 contract v2 data door, §2a. Exported with no android:permission
             on purpose: a custom permission could only be "normal" (any app may hold it) or
             "signature" (impossible — every app in this family has its own keystore, 42 of them),
             and neither buys anything AutomationCallers does not. The caller is identified by the
             framework and checked three ways: exact package name, uid cross-check, pinned signing
             certificate. -->
        <provider
            android:name=".automation.AutomationProvider"
            android:authorities="${applicationId}.automation"
            android:exported="true" />

        <service
            android:name=".automation.AutomationDataService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Automation data export/import" />
        </service>

        <!-- Capability discovery. Read with MATCH_UNINSTALLED_PACKAGES | MATCH_DISABLED_COMPONENTS,
             so 応用管理 can answer "can this app be backed up" for an app 白い熊 has frozen — a
             frozen app cannot be asked anything, which is why this is meta-data and not a query
             intent. An app without these entries is simply never offered for data backup. -->
        <meta-data android:name="shiroikuma.automation.contract" android:value="2" />
        <meta-data android:name="shiroikuma.automation.format" android:value="1" />
        <meta-data android:name="shiroikuma.automation.min_format" android:value="1" />
    </application>

</manifest>